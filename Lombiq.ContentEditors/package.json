{
  "private": true,
  "dependencies": {
    "vue-router": "3.6.5"
  },
  "scripts": {
    "build": "npm explore nodejs-extensions -- pnpm build",
    "clean": "npm explore nodejs-extensions -- pnpm clean",
    "watch": "npm explore nodejs-extensions -- pnpm watch"
  },
  "nodejsExtensions": {
    "assetsToCopy": [
      {
        "sources": [
          "node_modules/vue-router/dist"
        ],
        "pattern": "*",
        "target": "wwwroot/vendors/vue-router"
      }
    ]
  }
}
